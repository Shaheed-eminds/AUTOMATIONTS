{
  "name": "automationts",
  "version": "1.0.0",
  "description": "Reusable Playwright + TypeScript UI test automation framework.",
  "main": "index.js",
  "scripts": {
    "test": "playwright test --project=chrome",
    "test:headless": "cross-env HEADLESS=true playwright test --project=chrome",
    "test:debug": "playwright test --project=chrome --debug",
    "test:all-browsers": "playwright test",
    "test:chrome": "playwright test --project=chrome",
    "test:firefox": "playwright test --project=firefox",
    "test:webkit": "playwright test --project=webkit",
    "bddgen": "bddgen",
    "test:bdd": "bddgen && playwright test --project=bdd",
    "report": "playwright show-report reports/html-report",
    "codegen": "playwright codegen"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "@playwright/test": "^1.62.0",
    "@types/node": "^26.1.2",
    "cross-env": "^10.1.0",
    "dotenv": "^17.4.2",
    "nodemailer": "^9.0.4",
    "playwright-bdd": "^9.2.0",
    "typescript": "^7.0.2"
  }
}
